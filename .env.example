PREVENT_SLEEP=1
LOG_LEVEL=INFO
# seconds: music<->static crossfade, and pure static after the last knob turn (> 0)
STATIC_FADE=0.5
STATIC_HOLD=2.0
# KY-040 CLK (A) / DT (B), BCM numbering, used on Raspberry Pi only
ENC_LOC_A=17
ENC_LOC_B=27
ENC_EPOCH_A=22
ENC_EPOCH_B=23
# WLED controller on USB serial; empty turns the scale lights off. Mac: /dev/cu.usbserial-*, Pi: /dev/ttyUSB0 or /dev/ttyACM0
WLED_PORT=
# inclusive LED index ranges on one strip: one per location (in folder order), then exactly 3 for epochs
LED_LOCATIONS=0-5,6-11
LED_EPOCHS=12-15,16-19,20-23
# RRGGBB: selected position / the rest
LED_ON=FFA000
LED_OFF=100800
